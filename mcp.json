{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "olive-mcp": {
      "type": "stdio",
      "command": "python",
      "args": [
        "run.py"
      ],
      "cwd": "${PLUGIN_ROOT}/olive-mcp-server",
      "env": {
        "OLIVE_MCP_RETRIEVAL_MODE": "auto",
        "PYTHONPATH": "${PLUGIN_ROOT}/olive-mcp-server"
      }
    }
  }
}