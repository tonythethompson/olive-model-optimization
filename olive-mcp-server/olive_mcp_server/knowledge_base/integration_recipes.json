    {
      "id": "azure_ml_quant",
      "name": "Azure ML N-series Quantization",
      "description": "Cloud quantization pipeline targeting Azure ML GPU compute with AzureMLQuantization.",
      "model_type": [
        "LLM",
        "Transformer",
        "Vision"
      ],
      "target_hardware": [
        "Azure ML N-series"
      ],
      "source_format": "PyTorch",
      "passes": [
        "OnnxConversion",
        "OnnxQuantization",
        "AzureMLQuantization"
      ],
      "recipe": {
        "input_model": {
          "type": "HuggingfaceModel",
          "config": {
            "model_path": "microsoft/phi-4",
            "task": "text-generation",
            "load_kwargs": {
              "torch_dtype": "float32"
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "gpu",
                  "execution_providers": [
                    "CUDAExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "passes": {
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14
