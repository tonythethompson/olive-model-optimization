  "recipes": [
    {
      "id": "resnet50_cpu_ptq",
      "name": "ResNet-50 INT8 CPU",
      "description": "Static PTQ pipeline for a vision CNN targeting Intel/AMD CPUs with the ONNX Runtime CPU Execution Provider.",
      "model_type": [
        "CNN",
        "Vision"
      ],
      "target_hardware": [
        "Intel Core i9 CPU",
        "AMD EPYC CPU",
        "CPU"
      ],
      "source_format": "PyTorch",
      "passes": [
        "OnnxConversion",
        "OnnxStaticQuantization",
        "OnnxModelOptimizer"
      ],
      "recipe": {
        "input_model": {
          "type": "PyTorchModel",
          "config": {
            "model_path": "resnet50.pt",
            "io_config": {
              "input_names": [
                "input"
              ],
              "output_names": [
                "output"
              ],
              "input_shapes": [
                [
                  1,
                  3,
                  224,
                  224
                ]
              ]
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "cpu",
                  "execution_providers": [
                    "CPUExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "data_configs": [
          {
            "name": "imagenet_calib",
            "type": "HuggingfaceContainer",
            "params_config": {
              "data_path": "imagenet/val",
              "batch_size": 1
            }
          }
        ],
        "passes": {
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14
            }
          },
          "static_quant": {
            "type": "OnnxStaticQuantization",
            "config": {
              "quant_format": "QDQ",
              "per_channel": false,
              "data_config": "imagenet_calib"
            }
          },
          "optimize": {
            "type": "OnnxModelOptimizer"
          }
        },
        "evaluators": {
          "common_eval": {
            "metrics": [
              {
                "name": "accuracy",
                "type": "accuracy",
                "data_config": "imagenet_calib"
              }
            ]
          }
        },
        "engine": {
          "search_strategy": false,
          "host": "local_system",
          "target": "local_system",
          "evaluator": "common_eval",
          "cache_dir": ".cache",
          "output_dir": "outputs/resnet50_cpu_ptq"
        }
      },
      "notes": "Replace model_path and data_path with your own ResNet-50 checkpoint and calibration dataset."
    },
    {
      "id": "bert_cpu_static",
      "name": "BERT INT8 CPU",
      "description": "Static INT8 quantization of a Hugging Face BERT encoder for CPU inference.",
      "model_type": [
        "Transformer",
        "NLP",
        "BERT"
      ],
      "target_hardware": [
        "Intel Core i9 CPU",
        "CPU"
      ],
      "source_format": "HuggingFace",
      "passes": [
        "OnnxConversion",
        "OrtTransformersOptimization",
        "OnnxStaticQuantization"
      ],
      "recipe": {
        "input_model": {
          "type": "HuggingfaceModel",
          "config": {
            "model_path": "bert-base-uncased",
            "task": "text-classification",
            "load_kwargs": {
              "torch_dtype": "float32"
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "cpu",
                  "execution_providers": [
                    "CPUExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "data_configs": [
          {
            "name": "glue_calib",
            "type": "HuggingfaceContainer",
            "params_config": {
              "data_path": "glue/mrpc",
              "batch_size": 1,
              "max_seq_len": 128
            }
          }
        ],
        "passes": {
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14
            }
          },
          "transformers_opt": {
            "type": "OrtTransformersOptimization",
            "config": {
              "optimization_level": 1,
              "use_gpu": false
            }
          },
          "static_quant": {
            "type": "OnnxStaticQuantization",
            "config": {
              "quant_format": "QDQ",
              "data_config": "glue_calib"
            }
          }
        },
        "evaluators": {
          "common_eval": {
            "metrics": [
              {
                "name": "accuracy",
                "type": "accuracy",
                "data_config": "glue_calib"
              }
            ]
          }
        },
        "engine": {
          "search_strategy": false,
          "host": "local_system",
          "target": "local_system",
          "evaluator": "common_eval",
          "cache_dir": ".cache",
          "output_dir": "outputs/bert_cpu_static"
        }
      },
      "notes": "Best for BERT-like encoders. Update model_path and task for your specific checkpoint."
    },
    {
      "id": "llama3_cuda_awq",
      "name": "Llama-3 AWQ INT4 CUDA",
      "description": "AWQ INT4 weight-only quantization of a Llama-3 Hugging Face model for NVIDIA GPUs.",
      "model_type": [
        "LLM",
        "Transformer"
      ],
      "target_hardware": [
        "NVIDIA RTX 4090",
        "NVIDIA T4",
        "NVIDIA A100"
      ],
      "source_format": "HuggingFace",
      "passes": [
        "AutoAWQQuantizer",
        "OnnxConversion",
        "OnnxModelOptimizer"
      ],
      "recipe": {
        "input_model": {
          "type": "HuggingfaceModel",
          "config": {
            "model_path": "meta-llama/Meta-Llama-3-8B",
            "task": "text-generation",
            "load_kwargs": {
              "torch_dtype": "float16"
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "gpu",
                  "execution_providers": [
                    "CUDAExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "data_configs": [
          {
            "name": "wikitext2",
            "type": "HuggingfaceContainer",
            "params_config": {
              "data_path": "wikitext",
              "subset": "wikitext-2-raw-v1",
              "split": "train",
              "batch_size": 1,
              "max_seq_len": 2048
            }
          }
        ],
        "passes": {
          "awq": {
            "type": "AutoAWQQuantizer",
            "config": {
              "bits": 4,
              "group_size": 128,
              "zero_point": true,
              "data_config": "wikitext2"
            }
          },
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14
            }
          },
          "optimize": {
            "type": "OnnxModelOptimizer"
          }
        },
        "evaluators": {
          "common_eval": {
            "metrics": [
              {
                "name": "perplexity",
                "type": "perplexity",
                "data_config": "wikitext2"
              }
            ]
          }
        },
        "engine": {
          "search_strategy": false,
          "host": "local_system",
          "target": "local_system",
          "evaluator": "common_eval",
          "cache_dir": ".cache",
          "output_dir": "outputs/llama3_cuda_awq"
        }
      },
      "notes": "Requires AWQ support and significant GPU memory. Replace model_path with your Llama checkpoint."
    },
    {
