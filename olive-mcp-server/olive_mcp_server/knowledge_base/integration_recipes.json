        "OnnxModelOptimizer"
      ],
      "recipe": {
        "input_model": {
          "type": "HuggingfaceModel",
          "config": {
            "model_path": "meta-llama/Meta-Llama-3-8B",
            "task": "text-generation",
            "load_kwargs": {
              "torch_dtype": "float16"
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "gpu",
                  "execution_providers": [
                    "ROCMExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "data_configs": [
          {
            "name": "wikitext2",
            "type": "HuggingfaceContainer",
            "params_config": {
              "data_path": "wikitext",
              "subset": "wikitext-2-raw-v1",
              "split": "train",
              "batch_size": 1,
              "max_seq_len": 2048
            }
          }
        ],
        "passes": {
          "gptq": {
            "type": "GptqQuantizer",
            "config": {
              "bits": 4,
              "group_size": 128,
              "desc_act": false,
              "data_config": "wikitext2"
            }
          },
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14
            }
          },
          "optimize": {
