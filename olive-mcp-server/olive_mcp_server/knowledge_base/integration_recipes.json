    {
      "id": "llama_nvidia_int4",
      "name": "Llama-3 NVModelOpt INT4",
      "description": "INT4 quantization using NVIDIA ModelOpt for Llama-style LLMs on NVIDIA GPUs.",
      "model_type": [
        "LLM",
        "Transformer"
      ],
      "target_hardware": [
        "NVIDIA RTX 4090",
        "NVIDIA A100",
        "NVIDIA T4"
      ],
      "source_format": "HuggingFace",
      "passes": [
        "OnnxConversion",
        "NVModelOptQuantization",
        "OnnxFloatToFloat16"
      ],
      "recipe": {
        "input_model": {
          "type": "HuggingfaceModel",
          "config": {
            "model_path": "meta-llama/Meta-Llama-3-8B",
            "task": "text-generation",
            "load_kwargs": {
              "torch_dtype": "float16"
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "gpu",
                  "execution_providers": [
                    "CUDAExecutionProvider",
                    "TensorrtExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "data_configs": [
          {
            "name": "wikitext2",
            "type": "HuggingfaceContainer",
            "params_config": {
              "data_path": "wikitext",
              "subset": "wikitext-2-raw-v1",
              "split": "train",
              "batch_size": 1,
              "max_seq_len": 2048
            }
          }
        ],
        "passes": {
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14
            }
          },
          "nv_quant": {
            "type": "NVModelOptQuantization",
            "config": {
              "algorithm": "INT4_AWQ",
              "awq_block_size": 128,
              "data_config": "wikitext2"
            }
          },
          "fp16": {
            "type": "OnnxFloatToFloat16"
          }
        },
        "evaluators": {
          "common_eval": {
            "metrics": [
              {
                "name": "perplexity",
                "type": "perplexity",
                "data_config": "wikitext2"
              }
            ]
          }
        },
        "engine": {
          "search_strategy": false,
          "host": "local_system",
          "target": "local_system",
          "evaluator": "common_eval",
          "cache_dir": ".cache",
          "output_dir": "outputs/llama_nvidia_int4"
        }
      },
      "notes": "INT4 AWQ requires NVIDIA ModelOpt. Ensure the target GPU supports the selected execution provider."
    },
    {
      "id": "stable_diffusion_cuda_fp16",
      "name": "Stable Diffusion v1.4 FP16 CUDA",
      "description": "FP16 conversion and optimization for Stable Diffusion UNet on NVIDIA GPUs.",
      "model_type": [
        "Diffusion",
        "Vision"
      ],
      "target_hardware": [
        "NVIDIA RTX 4090",
        "NVIDIA A100"
      ],
      "source_format": "PyTorch",
      "passes": [
        "OnnxConversion",
        "OnnxFloatToFloat16",
        "OnnxModelOptimizer"
      ],
      "recipe": {
        "input_model": {
          "type": "PyTorchModel",
          "config": {
            "model_path": "CompVis/stable-diffusion-v1-4",
            "io_config": {
              "input_names": [
                "sample",
                "timestep",
                "encoder_hidden_states"
              ],
              "output_names": [
                "noise_pred"
              ],
              "input_shapes": [
                [
                  1,
                  4,
                  64,
                  64
                ],
                [
                  1
                ],
                [
                  1,
                  77,
                  768
                ]
              ]
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "gpu",
                  "execution_providers": [
                    "CUDAExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "passes": {
          "convert": {
            "type": "OnnxConversion",
            "config": {
              "target_opset": 14,
              "use_external_data_format": true
            }
          },
          "fp16": {
            "type": "OnnxFloatToFloat16"
          },
          "optimize": {
            "type": "OnnxModelOptimizer"
          }
        },
        "engine": {
          "search_strategy": false,
          "host": "local_system",
          "target": "local_system",
          "cache_dir": ".cache",
          "output_dir": "outputs/stable_diffusion_cuda_fp16"
        }
      },
      "notes": "FP16 halves memory and can speed up UNet inference on Tensor Cores. Set use_external_data_format=True for >2GB weights."
    },
    {
      "id": "phi4_cpu_int4",
      "name": "Phi-4 INT4 CPU",
      "description": "Block-wise RTN INT4 quantization of a Phi-4 Hugging Face model for CPU inference.",
      "model_type": [
        "LLM",
        "Transformer"
      ],
      "target_hardware": [
        "Intel Core i9 CPU",
        "AMD EPYC CPU",
        "CPU"
      ],
      "source_format": "HuggingFace",
      "passes": [
        "OnnxBlockWiseRtnQuantization",
        "OnnxModelOptimizer"
      ],
      "recipe": {
        "input_model": {
          "type": "HuggingfaceModel",
          "config": {
            "model_path": "microsoft/phi-4",
            "task": "text-generation",
            "load_kwargs": {
              "torch_dtype": "float32"
            }
          }
        },
        "systems": {
          "local_system": {
            "type": "LocalSystem",
            "config": {
              "accelerators": [
                {
                  "device": "cpu",
                  "execution_providers": [
                    "CPUExecutionProvider"
                  ]
                }
              ]
            }
          }
        },
        "passes": {
          "rtn_quant": {
            "type": "OnnxBlockWiseRtnQuantization",
            "config": {
              "bits": 4,
              "block_size": 32,
              "is_symmetric": true
            }
          },
          "optimize": {
            "type": "OnnxModelOptimizer"
          }
        },
        "engine": {
          "search_strategy": false,
          "host": "local_system",
          "target": "local_system",
          "cache_dir": ".cache",
          "output_dir": "outputs/phi4_cpu_int4"
        }
      },
      "notes": "RTN is fast but may reduce accuracy more than AWQ/GPTQ. Validate perplexity on your dataset."
    },
