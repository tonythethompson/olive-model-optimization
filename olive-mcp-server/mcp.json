{
  "mcpServers": {
    "olive-mcp": {
      "type": "stdio",
      "command": "python",
      "args": [
        "run.py"
      ],
      "cwd": "${olive-mcp-powers}/olive-mcp-server",
      "env": {
        "OLIVE_MCP_RETRIEVAL_MODE": "auto",
        "PYTHONPATH": "${olive-mcp-powers}/olive-mcp-server"
      },
      "disabled": false,
      "disabledTools": []
    }
  }
}
