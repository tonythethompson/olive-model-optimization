{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonythethompson/olive-model-optimization/blob/main/schemas/compatibility-v1.json",
  "title": "Olive model compatibility matrix",
  "type": "object",
  "required": ["version", "last_updated", "models", "olive_version_support"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "last_updated": { "type": "string", "format": "date" },
    "olive_version_support": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "string" },
        "max": { "type": "string" }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "hardware"],
        "properties": {
          "model": { "type": "string" },
          "hardware": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "pass_evidence": {
      "type": "object",
      "required": ["reference", "type", "version"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["olive_docs", "ort_docs", "github", "availability", "benchmark", "release_notes"]
        },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "pass_compat": {
      "type": "object",
      "required": ["support", "olive_pass", "evidence"],
      "properties": {
        "support": {
          "type": "string",
          "enum": ["supported", "warning", "unsupported"]
        },
        "olive_pass": { "type": "string" },
        "evidence": { "$ref": "#/$defs/pass_evidence" }
      },
      "additionalProperties": true
    }
  }
}
